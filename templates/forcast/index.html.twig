{% extends 'base.html.twig' %}

{% block title %}Forcast index{% endblock %}

{% block body %}
    <h1>Forcast index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Date</th>
                <th>Temperature</th>
                <th>Humidity</th>
                <th>Perceived_temperature</th>
                <th>Wind</th>
                {% if is_granted('ROLE_FORCAST_EDIT') or is_granted('ROLE_FORCAST_SHOW')  %}
                    <th>actions</th>
                {% endif %}
            </tr>
        </thead>
        <tbody>
        {% for forcast in forcasts %}
            <tr>
                <td>{{ forcast.id }}</td>
                <td>{{ forcast.date ? forcast.date|date('Y-m-d') : '' }}</td>
                <td>{{ forcast.temperature }}</td>
                <td>{{ forcast.humidity }}</td>
                <td>{{ forcast.perceivedTemperature }}</td>
                <td>{{ forcast.wind }}</td>
                {% if is_granted('ROLE_FORCAST_SHOW') or is_granted('ROLE_FORCAST_EDIT')  %}
                <td>
                    {% if is_granted('ROLE_FORCAST_SHOW')  %}
                        <a href="{{ path('app_forcast_show', {'id': forcast.id}) }}">show</a>
                    {% endif %}
                    {% if is_granted('ROLE_FORCAST_EDIT')  %}
                        <a href="{{ path('app_forcast_edit', {'id': forcast.id}) }}">edit</a>
                    {% endif %}
                </td>
                {% endif %}
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {% if is_granted('ROLE_FORCAST_NEW')   %}
        <a href="{{ path('app_forcast_new') }}">Create new</a>
    {% endif %}
{% endblock %}
